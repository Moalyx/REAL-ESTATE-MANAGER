<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/placeholder_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/logo"
        android:src="@drawable/real_estate"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="0dp">

                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_scrollFlags="scroll|exitUntilCollapsed">

                    <ImageView
                        android:id="@+id/main_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/main_property_photo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_launcher_background"
                        app:layout_collapseMode="parallax" />

                </com.google.android.material.appbar.CollapsingToolbarLayout>


            </com.google.android.material.appbar.AppBarLayout>

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

                <LinearLayout
                    android:id="@+id/linear1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/media_recyclerview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="24dp"
                        android:background="#E0D1FA"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_media_recyclerview" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:elevation="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/title_description"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginTop="15dp"
                                android:gravity="center"
                                android:text="@string/description"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/media_recyclerview" />

                            <TextView
                                android:id="@+id/description"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginTop="12dp"
                                android:hint="@string/lorem_ipsum_dolor"
                                android:textSize="15sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/title_description" />

                        </LinearLayout>


                    </androidx.cardview.widget.CardView>

                    <ImageView
                        android:id="@+id/separator1"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="#A9A9A9"
                        android:contentDescription="@string/separator" />


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:id="@+id/linear2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical"
                            app:layout_constraintEnd_toStartOf="@id/linear3"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">


                            <TextView
                                android:id="@+id/title_surface"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="15dp"
                                android:gravity="center"
                                android:text="@string/surface"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/ic_surface_2"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/description" />

                            <TextView
                                android:id="@+id/surface"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:hint="@string/_215"
                                android:textAlignment="center"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/title_surface" />

                            <TextView
                                android:id="@+id/title_number_room"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:gravity="center"
                                android:text="@string/number_of_rooms"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/ic_house_24"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/description" />

                            <TextView
                                android:id="@+id/number_room"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:hint="@string/_5"
                                android:textAlignment="center"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/title_surface" />

                            <TextView
                                android:id="@+id/title_number_bathroom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:gravity="center"
                                android:text="@string/number_of_bathrooms"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/ic_baseline_bathtub_24"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/description" />

                            <TextView
                                android:id="@+id/number_bathroom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:hint="@string/_2"
                                android:textAlignment="center"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/title_surface" />

                            <TextView
                                android:id="@+id/title_number_bedroom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:gravity="center"
                                android:text="@string/number_of_bedrooms"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/ic_baseline_bedroom_parent_24"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/description" />

                            <TextView
                                android:id="@+id/number_bedroom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:hint="@string/_3"
                                android:textAlignment="center"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/title_surface" />

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/separator2"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:background="#A9A9A9"
                            android:contentDescription="@string/separator"
                            app:layout_constraintTop_toBottomOf="@id/linear2" />

                        <LinearLayout
                            android:id="@+id/linear3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical"
                            app:layout_constraintStart_toEndOf="@id/linear2"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/title_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="15dp"
                                android:gravity="center"
                                android:text="@string/price"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/ic_baseline_attach_money_24"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/description" />

                            <TextView
                                android:id="@+id/price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:hint="@string/_3000_000"
                                android:textAlignment="center"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/title_surface" />

                            <TextView
                                android:id="@+id/title_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="5dp"
                                android:gravity="center"
                                android:text="@string/type"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/ic_round_type"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/description" />

                            <TextView
                                android:id="@+id/type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:hint="@string/house"
                                android:textAlignment="center"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/title_surface" />

                            <TextView
                                android:id="@+id/point_of_interest"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="5dp"
                                android:gravity="center"
                                android:text="@string/point_of_interest"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/ic_round_type"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/description" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_marginStart="24dp"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/poi_park"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/park"
                                    android:src="@drawable/ic_baseline_forest_24"
                                    android:visibility="gone" />

                                <ImageView
                                    android:id="@+id/poi_school"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/school"
                                    android:src="@drawable/ic_baseline_school_24"
                                    android:visibility="gone" />

                                <ImageView
                                    android:id="@+id/poi_train"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/train"
                                    android:src="@drawable/ic_baseline_subway_24"
                                    android:visibility="gone" />

                                <ImageView
                                    android:id="@+id/poi_bus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/bus"
                                    android:src="@drawable/ic_bus_station_24"
                                    android:visibility="gone" />

<!--                                <ImageView-->
<!--                                    android:id="@+id/poi_shop"-->
<!--                                    android:layout_width="wrap_content"-->
<!--                                    android:layout_height="wrap_content"-->
<!--                                    android:contentDescription="shop"-->
<!--                                    android:src="@drawable/ic_baseline_local_grocery_store_24"-->
<!--                                    android:visibility="gone" />-->

                                <ImageView
                                    android:id="@+id/poi_airport"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/airport"
                                    android:src="@drawable/ic_baseline_local_airport_24"
                                    android:visibility="gone" />

                                <ImageView
                                    android:id="@+id/poi_resto"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/restaurant"
                                    android:src="@drawable/ic_baseline_fastfood_24"
                                    android:visibility="gone" />


                            </LinearLayout>

                            <TextView
                                android:id="@+id/title_agent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:gravity="center"
                                android:text="@string/agent_in_charge"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/ic_baseline_person_24"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/description" />

                            <TextView
                                android:id="@+id/agent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:hint="@string/mike"
                                android:textAlignment="center"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/title_surface" />


                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/linear6"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/separator2">

                            <TextView
                                android:id="@+id/sale_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginTop="5dp"
                                android:gravity="center"
                                android:text="@string/sale_status"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/money"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/description" />

                            <TextView
                                android:id="@+id/status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:hint="@string/available_for_sale"
                                android:textAlignment="center"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/title_surface" />

                            <TextView
                                android:id="@+id/sale_since"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginTop="5dp"
                                android:gravity="center"
                                android:text="@string/on_sale_date"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/ic_baseline_date_range_24"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/description" />

                            <TextView
                                android:id="@+id/on_sale_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:hint="@string/_23_02_2023"
                                android:textAlignment="center"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/title_surface" />

                            <TextView
                                android:id="@+id/date_of_sale"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginTop="5dp"
                                android:gravity="center"
                                android:text="@string/date_of_sale"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/ic_baseline_date_range_24"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/description" />

                            <TextView
                                android:id="@+id/sold_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:hint="@string/not_yet_sold"
                                android:textAlignment="center"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/title_surface" />

                        </LinearLayout>


                        <ImageView
                            android:id="@+id/separator3"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:background="#A9A9A9"
                            android:contentDescription="@string/separator"
                            app:layout_constraintBottom_toTopOf="@id/linear4"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />


                        <LinearLayout
                            android:id="@+id/linear4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/linear6"

                            >

                            <TextView
                                android:id="@+id/title_location"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="15dp"
                                android:gravity="center"
                                android:text="@string/location"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/ic_baseline_location_24"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/description" />

                            <TextView
                                android:id="@+id/address"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:hint="@string/_385_wilson_avenue" />

<!--                            <TextView-->
<!--                                android:id="@+id/complement_adress"-->
<!--                                android:layout_width="wrap_content"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:layout_marginTop="4dp"-->
<!--                                android:hint="apartment 123" />-->

                            <TextView
                                android:id="@+id/zipcode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:hint="@string/_80022" />

                            <TextView
                                android:id="@+id/city"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:hint="@string/denver" />

                            <TextView
                                android:id="@+id/state"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:hint="@string/ile_de_france" />

                            <TextView
                                android:id="@+id/country"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:hint="@string/united_states" />


                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/linear5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:layout_constraintStart_toStartOf="@id/linear3"
                            app:layout_constraintTop_toTopOf="@id/linear4">

                            <ImageView
                                android:id="@+id/static_map"
                                android:layout_width="150dp"
                                android:layout_height="150dp"
                                android:contentDescription="@string/staticmap" />

                        </LinearLayout>


                    </androidx.constraintlayout.widget.ConstraintLayout>


                </LinearLayout>

            </androidx.core.widget.NestedScrollView>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>